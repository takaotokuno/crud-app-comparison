{
  "name": "ASP.NET Core Web API + React/Next.js",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/aspnetcore-nextjs",
  "remoteUser": "vscode",
  "runServices": [
    "db",
    "devcontainer"
  ],
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "forwardPorts": [
    5000,
    5001,
    3000,
    1433
  ],
  "portsAttributes": {
    "5000": {
      "label": "ASP.NET Core Web API"
    },
    "5001": {
      "label": "ASP.NET Core HTTPS"
    },
    "3000": {
      "label": "Next.js"
    },
    "1433": {
      "label": "SQL Server"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
